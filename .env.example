# ==========================================
# Configuración del Agente AetherSync
# ==========================================

# URL raíz de la API de origen
API_ROOT=https://example.com/api/v1/
API_LOGIN=YOUR_USERNAME
API_PASSWORD=YOUR_PASSWORD

# Cadena de conexión hacia SQL Server (Base de datos local)
# Nota: Si estás en un entorno local sin certificados SSL instalados, mantén TrustServerCertificate=yes
DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=TU_SERVIDOR;Database=VCashApp;Uid=TU_USUARIO;Pwd=TU_PASSWORD;Encrypt=yes;TrustServerCertificate=yes;

# Parámetros operativos de sincronización
SYNC_INTERVAL_SECONDS=300
BATCH_SIZE=1000